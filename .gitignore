# ==============================
# UNILINK — .gitignore
# ==============================

# --- Env & Secrets ---
.env
api/.env
*.env
*.env.local
*.env.production

# --- Dependências ---
node_modules/
api/node_modules/
**/node_modules/
package-lock.json
api/package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Logs ---
logs/
api/logs/*.log
api/logs/*.log.*
logs-export-*/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE ---
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace

# --- Build / Deploy ---
dist/
build/
out/
.next/
.nuxt/
.coverage/
.vercel/
.netlify/
render.yaml.bak

# --- Supabase ---
.supabase/
temp/
tmp/

# --- Outros ---
*.bak
*.tmp
*.cache
